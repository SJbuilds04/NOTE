# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local Expo module native build output (generated by Gradle)
modules/*/android/build/
modules/*/android/.cxx/

# Release signing material -- never commit these
*.keystore
credentials/

# Brag/showcase video output. Contains a bundled third-party music track whose
# redistribution terms are not verified here -- publish the rendered MP4 as a
# release asset or on social instead of committing the raw project assets.
brag-output/

# Gradle build cache inside local Expo modules
modules/*/android/.gradle/
